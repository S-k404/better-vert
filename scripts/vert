#!/usr/bin/env bash
# Better VERT command line client.
#
# Drives the local Better VERT API from the terminal: universal format
# conversion, Markdown extraction, media inspection and stack lifecycle.
# Run with no arguments for the interactive picker, or `vert help` for usage.
#
# Written for bash 3.2 (the version macOS ships), so no associative arrays and
# no bare "${arr[@]}" expansion on a possibly-empty array under `set -u`.

set -euo pipefail

# Resolve symlinks before locating the project: install.sh links this file onto
# the PATH, and `dirname "$0"` would then name the link's directory, not the repo.
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
unset _src _dir

# shellcheck source=lib/platform.sh
. "$SCRIPT_DIR/lib/platform.sh"

# Host port: .env wins, then the environment, then the compose default.
PORT_FROM_ENV=""
if [ -f "$PROJECT_DIR/.env" ]; then
  PORT_FROM_ENV="$(grep -E '^PORT=' "$PROJECT_DIR/.env" | tail -1 | cut -d= -f2- | tr -d '"'"'"' \r' || true)"
fi
PORT="${VERT_PORT:-${PORT_FROM_ENV:-8394}}"
API="http://127.0.0.1:${PORT}"

# ---------------------------------------------------------------------------
# Output helpers. Colour only when stdout is a terminal.
# ---------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m';  C_BOLD=$'\033[1m'
  C_CYAN=$'\033[36m'; C_GREEN=$'\033[32m'; C_YEL=$'\033[33m'
  C_RED=$'\033[31m';  C_MAG=$'\033[35m';   C_BLUE=$'\033[34m'
else
  C_RESET=''; C_DIM=''; C_BOLD=''; C_CYAN=''; C_GREEN=''
  C_YEL=''; C_RED=''; C_MAG=''; C_BLUE=''
fi

info() { printf '%s==>%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }
ok()   { printf '%s  ✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s  !%s %s\n' "$C_YEL" "$C_RESET" "$*" >&2; }
die()  { printf '%s  ✗%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

banner() {
  printf '\n%s  Better VERT%s %s· local universal conversion%s\n' \
    "$C_BOLD$C_MAG" "$C_RESET" "$C_DIM" "$C_RESET"
  printf '%s  %s%s\n\n' "$C_DIM" "$API" "$C_RESET"
}

pp() {
  if command -v jq >/dev/null 2>&1; then jq .
  elif command -v python3 >/dev/null 2>&1; then python3 -m json.tool
  else cat
  fi
}

need_curl() { command -v curl >/dev/null 2>&1 || die "curl is required but not installed."; }
is_up()     { curl -fsS --max-time 3 "$API/api/version" >/dev/null 2>&1; }
require_up(){ is_up || die "Better VERT is not responding on $API. Start it with: vert up"; }
# `compose` itself comes from lib/platform.sh (v2 plugin, v1 binary fallback).
vert_compose() {
  command -v docker >/dev/null 2>&1 || die "Docker is not installed. Get it: https://docs.docker.com/get-docker/"
  compose_available || die "Docker Compose is not available. Update Docker, or install the Compose plugin."
  (cd "$PROJECT_DIR" && compose "$@")
}

# ---------------------------------------------------------------------------
# Format catalogue - the same categories the web UI shows.
# Served from the API when reachable, with a static fallback so `vert formats`
# and the picker still work when the container is down.
# ---------------------------------------------------------------------------
CAT_NAMES="video audio image document data cross"

cat_label() {
  case "$1" in
    video)    echo "Video" ;;
    audio)    echo "Audio" ;;
    image)    echo "Image" ;;
    document) echo "Document" ;;
    data)     echo "Data" ;;
    cross)    echo "Cross-medium" ;;
    *)        echo "$1" ;;
  esac
}

cat_icon() {
  case "$1" in
    video) echo "🎬" ;; audio) echo "🎧" ;; image) echo "🖼 " ;;
    document) echo "📄" ;; data) echo "📊" ;; cross) echo "✨" ;; *) echo "•" ;;
  esac
}

cat_formats_static() {
  case "$1" in
    video)    echo "mp4 mkv webm mov avi gif av1 wmv flv m4v ts mts m2ts vob ogv 3gp asf" ;;
    audio)    echo "mp3 wav aac flac m4a m4b ogg opus wma aiff alac ac3 caf mp2 aif" ;;
    image)    echo "png jpg jpeg webp avif gif tiff bmp ico svg" ;;
    document) echo "pdf docx md html epub txt rtf odt" ;;
    data)     echo "json csv yaml yml xml tsv xlsx" ;;
    cross)    echo "pdf_storyboard waveform_video images_zip transcript_md" ;;
  esac
}

# Echoes the formats for category $1, preferring the live catalogue.
cat_formats() {
  local c="$1" live=""
  if is_up; then
    if command -v python3 >/dev/null 2>&1; then
      live="$(curl -fsS --max-time 5 "$API/api/formats-catalog" 2>/dev/null \
        | python3 -c 'import json,sys;print(" ".join(json.load(sys.stdin)["categories"].get(sys.argv[1],[])))' "$c" 2>/dev/null || true)"
    elif command -v jq >/dev/null 2>&1; then
      live="$(curl -fsS --max-time 5 "$API/api/formats-catalog" 2>/dev/null \
        | jq -r --arg c "$c" '(.categories[$c] // []) | join(" ")' 2>/dev/null || true)"
    fi
  fi
  if [ -n "$live" ]; then echo "$live"; else cat_formats_static "$c"; fi
}

# ---------------------------------------------------------------------------
# Interactive arrow-key menu.
#   menu_select "Prompt" opt1 opt2 ...   ->  MENU_INDEX / MENU_CHOICE
# Up/Down or k/j to move, Enter to pick, q or Esc to cancel.
# Falls back to a numbered prompt when stdin is not a terminal.
# ---------------------------------------------------------------------------
MENU_INDEX=0
MENU_CHOICE=""

menu_select() {
  local prompt="$1"; shift
  local n=$#
  [ "$n" -gt 0 ] || die "menu_select: no options"

  # Non-interactive: plain numbered list.
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    local i=1
    printf '%s\n' "$prompt" >&2
    for opt in "$@"; do printf '  %2d) %s\n' "$i" "$opt" >&2; i=$((i+1)); done
    printf 'Choice [1-%d]: ' "$n" >&2
    local reply; read -r reply
    [ "$reply" -ge 1 ] 2>/dev/null && [ "$reply" -le "$n" ] || die "invalid choice"
    MENU_INDEX=$((reply-1))
    eval "MENU_CHOICE=\${$reply}"
    return 0
  fi

  local sel=0 key rest first=1
  printf '\033[?25l'                       # hide cursor
  trap 'printf "\033[?25h"' RETURN

  while :; do
    if [ "$first" -eq 1 ]; then
      printf '%s%s%s  %s(↑/↓ move · enter select · q cancel)%s\n' \
        "$C_BOLD" "$prompt" "$C_RESET" "$C_DIM" "$C_RESET"
      first=0
    else
      printf '\033[%dA' "$n"               # rewind over the previous list
    fi

    local i=0
    for opt in "$@"; do
      printf '\033[2K'                     # clear the line
      if [ "$i" -eq "$sel" ]; then
        printf '  %s❯%s %s%s%s\n' "$C_CYAN" "$C_RESET" "$C_BOLD$C_CYAN" "$opt" "$C_RESET"
      else
        printf '    %s%s%s\n' "$C_DIM" "$opt" "$C_RESET"
      fi
      i=$((i+1))
    done

    IFS= read -rsn1 key || { printf '\033[?25h'; die "cancelled"; }
    case "$key" in
      $'\033')
        # Arrow keys arrive as ESC [ A/B. Bare Esc cancels after the timeout.
        if IFS= read -rsn2 -t 1 rest 2>/dev/null; then
          case "$rest" in
            '[A') sel=$(( (sel - 1 + n) % n )) ;;
            '[B') sel=$(( (sel + 1) % n )) ;;
          esac
        else
          printf '\033[?25h'; die "cancelled"
        fi
        ;;
      k) sel=$(( (sel - 1 + n) % n )) ;;
      j) sel=$(( (sel + 1) % n )) ;;
      q) printf '\033[?25h'; die "cancelled" ;;
      '') break ;;                         # Enter
    esac
  done

  printf '\033[?25h'
  MENU_INDEX="$sel"
  eval "MENU_CHOICE=\${$((sel+1))}"
}

# ---------------------------------------------------------------------------
# Progress bar.
#
# The API returns one response at the end of a conversion, so there is no
# byte-level progress to report mid-flight. The bar therefore eases towards 90%
# while the request is in flight and snaps to 100% on completion - it reports
# elapsed work, not a measured fraction, and the elapsed timer is exact.
# ---------------------------------------------------------------------------
BAR_WIDTH=34

draw_bar() {
  local pct="$1" label="$2" elapsed="$3"
  local filled=$(( pct * BAR_WIDTH / 100 ))
  local empty=$(( BAR_WIDTH - filled ))
  local bar="" i=0
  while [ "$i" -lt "$filled" ]; do bar="${bar}█"; i=$((i+1)); done
  i=0
  while [ "$i" -lt "$empty" ]; do bar="${bar}░"; i=$((i+1)); done
  printf '\r\033[2K  %s%s%s %s%3d%%%s  %s  %s%ds%s' \
    "$C_CYAN" "$bar" "$C_RESET" "$C_BOLD" "$pct" "$C_RESET" \
    "$label" "$C_DIM" "$elapsed" "$C_RESET"
}

# run_with_progress <label> <command...>
# Runs the command in the background and animates a bar until it exits.
run_with_progress() {
  local label="$1"; shift

  if [ ! -t 1 ]; then "$@"; return $?; fi

  "$@" & local pid=$!
  local start=$SECONDS pct=0 elapsed=0

  printf '\033[?25l'
  while kill -0 "$pid" 2>/dev/null; do
    elapsed=$(( SECONDS - start ))
    # Asymptotic ease toward 90%: fast at first, slower as it goes.
    pct=$(( 90 - (90 * 100) / (100 + elapsed * 18) ))
    [ "$pct" -lt 0 ] && pct=0
    draw_bar "$pct" "$label" "$elapsed"
    sleep 0.1 2>/dev/null || sleep 1
  done

  wait "$pid"; local rc=$?
  elapsed=$(( SECONDS - start ))
  if [ "$rc" -eq 0 ]; then
    draw_bar 100 "$label" "$elapsed"
    printf '\n'
  else
    printf '\r\033[2K'
  fi
  printf '\033[?25h'
  return "$rc"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_up() {
  info "Starting Better VERT on port $PORT..."
  if [ $# -gt 0 ]; then vert_compose up -d "$@"; else vert_compose up -d; fi
  info "Waiting for the API..."
  local i=0
  printf '\033[?25l'
  while [ "$i" -lt 90 ]; do
    if is_up; then
      printf '\r\033[2K'; printf '\033[?25h'
      ok "ready at $API"
      return 0
    fi
    draw_bar $(( i * 100 / 90 )) "starting container" "$i"
    sleep 1; i=$((i+1))
  done
  printf '\033[?25h'; printf '\n'
  die "Timed out waiting for $API. Check: vert logs"
}

cmd_down() { info "Stopping Better VERT..."; if [ $# -gt 0 ]; then vert_compose down "$@"; else vert_compose down; fi; }

cmd_logs() { if [ $# -gt 0 ]; then vert_compose logs "$@" better-vert; else vert_compose logs --tail=100 better-vert; fi; }

cmd_open() {
  require_up
  open_url "$API" || echo "$API"
}

cmd_status() {
  need_curl
  is_up && ok "API is up at $API" || die "API is not reachable at $API"
  curl -fsS "$API/api/system-info" | pp
}

cmd_formats() {
  need_curl
  local cats="$CAT_NAMES"
  [ $# -gt 0 ] && cats="$*"
  for c in $cats; do
    local fmts; fmts="$(cat_formats "$c")"
    [ -n "$fmts" ] || { warn "unknown category: $c"; continue; }
    printf '\n%s %s%s%s\n' "$(cat_icon "$c")" "$C_BOLD" "$(cat_label "$c")" "$C_RESET"
    printf '   %s%s%s\n' "$C_DIM" "$fmts" "$C_RESET"
  done
  printf '\n'
}

cmd_inspect() {
  need_curl; require_up
  [ $# -ge 1 ] || die "usage: vert inspect <file>"
  [ -f "$1" ] || die "no such file: $1"
  local tmp; tmp="$(mktemp)"
  run_with_progress "inspecting $(basename "$1")" \
    curl -fsS -o "$tmp" -F "file=@$1" "$API/api/inspect-media" \
    || { rm -f "$tmp"; die "Inspection failed. See: vert logs"; }
  pp < "$tmp"; rm -f "$tmp"
}

# do_convert <input> <target> <outdir> [extra curl -F args...]
do_convert() {
  local input="$1" target="$2" outdir="$3"; shift 3
  mkdir -p "$outdir"

  local headers body name
  headers="$(mktemp)"
  body="$outdir/.vert-download.$$"

  local rc=0
  if [ $# -gt 0 ]; then
    run_with_progress "$(basename "$input") → $target" \
      curl -fsS -D "$headers" -o "$body" \
      -F "file=@$input" -F "target_format=$target" "$@" \
      "$API/api/convert-universal" || rc=$?
  else
    run_with_progress "$(basename "$input") → $target" \
      curl -fsS -D "$headers" -o "$body" \
      -F "file=@$input" -F "target_format=$target" \
      "$API/api/convert-universal" || rc=$?
  fi

  if [ "$rc" -ne 0 ]; then
    rm -f "$body" "$headers"
    die "Conversion failed. Full detail is in the server log: vert logs"
  fi

  # Trim with sed, not xargs: xargs collapses repeated spaces inside the name
  # ("my  file.mp3" would be saved as "my file.mp3").
  name="$(grep -i '^x-converted-file:' "$headers" | tail -1 | cut -d: -f2- | tr -d '\r' \
    | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' || true)"
  [ -n "$name" ] || name="$(basename "${input%.*}").$target"
  rm -f "$headers"
  mv "$body" "$outdir/$name"

  local bytes; bytes="$(wc -c < "$outdir/$name" | tr -d ' ')"
  ok "$outdir/$name ${C_DIM}($(human_size "$bytes"))${C_RESET}"
}

human_size() {
  local b="$1"
  if   [ "$b" -ge 1073741824 ]; then awk -v b="$b" 'BEGIN{printf "%.2f GB", b/1073741824}'
  elif [ "$b" -ge 1048576 ];    then awk -v b="$b" 'BEGIN{printf "%.2f MB", b/1048576}'
  elif [ "$b" -ge 1024 ];       then awk -v b="$b" 'BEGIN{printf "%.1f KB", b/1024}'
  else printf '%s B' "$b"
  fi
}

cmd_convert() {
  need_curl; require_up
  local input="" target="" outdir="."
  local extra=""            # newline-separated "key=value" pairs
  while [ $# -gt 0 ]; do
    case "$1" in
      -t|--to)          target="$2"; shift 2 ;;
      -o|--out-dir)     outdir="$2"; shift 2 ;;
      --crf)            extra="$extra
crf=$2"; shift 2 ;;
      --resolution)     extra="$extra
resolution=$2"; shift 2 ;;
      --codec)          extra="$extra
video_codec=$2"; shift 2 ;;
      --audio-bitrate)  extra="$extra
audio_bitrate=$2"; shift 2 ;;
      --fps)            extra="$extra
fps=$2"; shift 2 ;;
      --quality)        extra="$extra
quality=$2"; shift 2 ;;
      --trim-start)     extra="$extra
trim_start=$2"; shift 2 ;;
      --trim-duration)  extra="$extra
trim_duration=$2"; shift 2 ;;
      --speed)          extra="$extra
playback_speed=$2"; shift 2 ;;
      --dpi)            extra="$extra
dpi=$2"; shift 2 ;;
      --loudnorm)       extra="$extra
loudnorm=true"; shift ;;
      -h|--help)        cmd_help; return 0 ;;
      -*)               die "unknown option: $1" ;;
      *)                input="$1"; shift ;;
    esac
  done

  [ -n "$input" ] || die "usage: vert convert <file> --to <format> [options]"
  [ -f "$input" ] || die "no such file: $input"
  [ -n "$target" ] || die "--to <format> is required (see: vert formats)"

  # Rebuild the curl -F arguments without ever expanding an empty array.
  set --
  local line
  while IFS= read -r line; do
    [ -n "$line" ] && set -- "$@" -F "$line"
  done <<EOF
$extra
EOF

  do_convert "$input" "$target" "$outdir" "$@"
}

cmd_md() {
  need_curl; require_up
  local outdir="." files="" f
  while [ $# -gt 0 ]; do
    case "$1" in
      -o|--out-dir) outdir="$2"; shift 2 ;;
      -h|--help)    cmd_help; return 0 ;;
      -*)           die "unknown option: $1" ;;
      *)            files="$files
$1"; shift ;;
    esac
  done

  # Collect the -F arguments positionally so we never expand an empty array.
  set --
  local count=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ -f "$f" ] || die "no such file: $f"
    set -- "$@" -F "files=@$f"
    count=$((count+1))
  done <<EOF
$files
EOF

  [ "$count" -gt 0 ] || die "usage: vert md <file...> [-o <dir>]"
  md_fetch_zip "$outdir" "$count file(s) → markdown" "$@"
}

cmd_batch() {
  need_curl; require_up
  local tmp; tmp="$(mktemp)"
  run_with_progress "batch converting ./input" \
    curl -fsS -o "$tmp" -X POST "$API/api/batch-convert" \
    || { rm -f "$tmp"; die "Batch conversion failed. See: vert logs"; }
  pp < "$tmp"; rm -f "$tmp"
}

cmd_ls() { need_curl; require_up; curl -fsS "$API/api/batch-status" | pp; }

# ---------------------------------------------------------------------------
# Interactive mode
# ---------------------------------------------------------------------------
cmd_interactive() {
  need_curl
  banner
  is_up || die "Better VERT is not running. Start it with: vert up"

  # 1. What to do
  menu_select "What would you like to do?" \
    "Convert a file to another format" \
    "Convert files to Markdown" \
    "Inspect a file" \
    "Batch-convert ./input" \
    "Show system status"
  local action=$MENU_INDEX
  printf '\n'

  case "$action" in
    3) cmd_batch; return ;;
    4) cmd_status; return ;;
  esac

  # 2. Which file
  local file=""
  printf '%sFile path%s %s(tab completes)%s: ' "$C_BOLD" "$C_RESET" "$C_DIM" "$C_RESET"
  IFS= read -r -e file
  file="${file/#\~/$HOME}"
  eval "file=$(printf '%q' "$file")" 2>/dev/null || true
  [ -f "$file" ] || die "no such file: $file"
  printf '\n'

  case "$action" in
    1) md_convert_files "$file"; return ;;
    2) cmd_inspect "$file"; return ;;
  esac

  # 3. Category, then format - the same grouping the web UI uses
  local labels="" c
  set --
  for c in $CAT_NAMES; do
    set -- "$@" "$(cat_icon "$c") $(cat_label "$c")"
  done
  menu_select "Target category" "$@"
  local chosen_cat; chosen_cat="$(echo "$CAT_NAMES" | cut -d' ' -f$((MENU_INDEX+1)))"
  printf '\n'

  local fmts; fmts="$(cat_formats "$chosen_cat")"
  set --
  for f in $fmts; do set -- "$@" "$f"; done
  menu_select "Target format" "$@"
  local target="$MENU_CHOICE"
  printf '\n'

  do_convert "$file" "$target" "."
}

# md_fetch_zip <outdir> <label> <curl -F args...>
md_fetch_zip() {
  local outdir="$1" label="$2"; shift 2
  mkdir -p "$outdir"
  local zip="$outdir/better_vert_markdown.zip"
  run_with_progress "$label" \
    curl -fsS -o "$zip" "$@" "$API/api/convert-markdown-zip" \
    || { rm -f "$zip"; die "Markdown conversion failed. See: vert logs"; }

  if command -v unzip >/dev/null 2>&1; then
    unzip -oq "$zip" -d "$outdir" && rm -f "$zip"
    ok "Markdown written to $outdir/"
  else
    ok "$zip"
  fi
}

md_convert_files() {
  md_fetch_zip "." "$(basename "$1") → markdown" -F "files=@$1"
}

cmd_help() {
  banner
  cat <<USAGE
${C_BOLD}Usage${C_RESET}
  vert                      Interactive picker (arrow keys)
  vert <command> [options]

${C_BOLD}Stack${C_RESET}
  up [--build]              Start the container and wait until the API answers
  down                      Stop the container
  logs [-f]                 Tail container logs
  status                    Health check plus host/acceleration telemetry
  open                      Open the web UI in your browser

${C_BOLD}Convert${C_RESET}
  convert <file> --to <fmt> [options]
      -o, --out-dir <dir>   Where to write the result (default: current dir)
      --crf <n>             Video quality, lower is better (e.g. 18)
      --resolution <WxH>    e.g. 1920x1080
      --codec <name>        e.g. libx264, libx265
      --audio-bitrate <br>  e.g. 192k
      --fps <n>             Output frame rate
      --quality <n>         Image quality, 1-100
      --trim-start <ts>     e.g. 00:00:05
      --trim-duration <ts>  e.g. 00:00:30
      --speed <x>           Playback speed multiplier, e.g. 1.5
      --dpi <n>             Rasterisation DPI for document routes
      --loudnorm            Normalise audio loudness

  md <file...> [-o <dir>]   Convert anything to Markdown (OCR + figure extraction)
  batch                     Convert everything in ./input to ./output
  inspect <file>            Stream/codec/metadata telemetry for any file
  formats [category]        Supported formats: $CAT_NAMES
  ls                        List what is currently in ./input and ./output

${C_BOLD}Environment${C_RESET}
  VERT_PORT                 Override the API port (default: PORT in .env, else 8394)
  NO_COLOR                  Disable coloured output

${C_BOLD}Examples${C_RESET}
  vert up --build
  vert convert clip.mov --to mp4 --crf 20 --resolution 1920x1080
  vert md report.pdf slides.pptx -o ./notes
  vert inspect movie.mkv
USAGE
}

# ---------------------------------------------------------------------------
cmd="${1:-}"
[ $# -gt 0 ] && shift || true
case "$cmd" in
  "")              cmd_interactive ;;
  i|interactive)   cmd_interactive ;;
  up)              cmd_up "$@" ;;
  down)            cmd_down "$@" ;;
  logs)            cmd_logs "$@" ;;
  open)            cmd_open "$@" ;;
  status|health)   cmd_status "$@" ;;
  formats)         cmd_formats "$@" ;;
  inspect)         cmd_inspect "$@" ;;
  convert)         cmd_convert "$@" ;;
  md|markdown)     cmd_md "$@" ;;
  batch)           cmd_batch "$@" ;;
  ls)              cmd_ls "$@" ;;
  help|-h|--help)  cmd_help ;;
  *)               die "unknown command: $cmd (try: vert help)" ;;
esac
