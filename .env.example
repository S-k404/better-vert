# Host port the Better VERT UI is served on (container always listens on 8000).
PORT=8394

# Per-file upload ceiling in MB.
MAX_UPLOAD_MB=2048

# Linux hosts only: match the container user to your host user so it can write
# to ./output and ./input. Leave unset on macOS/Windows Docker Desktop.
# VERT_UID=1000
# VERT_GID=1000
